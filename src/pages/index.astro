---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ParallaxStack from '../components/ParallaxStack.astro';
import CvToSite from '../components/CvToSite.astro';
import BuildScrubber from '../components/BuildScrubber.astro';
import WhatYouGet from '../components/WhatYouGet.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Nav />
  <main id="top">
    <Hero />
    <ParallaxStack />
    <CvToSite />
    <BuildScrubber />
    <WhatYouGet />
    <Pricing />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Layout>
