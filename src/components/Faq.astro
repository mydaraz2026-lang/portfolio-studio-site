---
import { faq } from '../data/site';
---
<div class="band"><section class="sec" id="faq"><div class="wrap">
  <div class="sec-head"><span class="eyebrow">FAQ</span><h2>Questions, answered.</h2></div>
  <div class="faq">
    {faq.map(([q, a], i) => (
      <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>
    ))}
  </div>
</div></section></div>
