---
import { getItems } from '../data/site';
---
<section class="sec" id="get"><div class="wrap get">
  <div class="sec-head" style="margin:0"><span class="eyebrow">What you get</span><h2>Everything in one link.</h2><p>A website built from your story, with your numbers, timeline and credentials in one place.</p></div>
  <ol>
    {getItems.map(([title, detail], i) => (
      <li><span>{String(i + 1).padStart(2, '0')}</span><div>{title}<small>{detail}</small></div></li>
    ))}
  </ol>
</div></section>
