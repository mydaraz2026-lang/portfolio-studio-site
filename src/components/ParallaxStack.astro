---
import { sites } from '../data/site';
---
<span id="samples" style="display:block;position:relative;top:-8px"></span>
<div class="px" id="px">
  <div class="px-stage" id="stage">
    <div class="px-title"><span class="eyebrow">Live samples</span><h2>Profiles already <em>live.</em></h2></div>
    <div class="px-ghost" data-k="ghost" aria-hidden="true">PROFILES</div>
    <div class="px-glow" data-k="glow" aria-hidden="true"></div>
    {sites.map((site, i) => (
      <a class="px-item px-card" data-k={`c${i}`} href={site.url} target="_blank" rel="noopener" aria-label={`Open ${site.name}'s live site`} style="text-decoration:none"><div class="hd"><div class="who">{site.name}</div><span class="live">Live</span></div><img class="shot" src={site.image} alt={`Screenshot of ${site.name}'s portfolio site`} width="960" height="480" loading="lazy" decoding="async" /><div class="url">{site.host}</div></a>
    ))}
    <div class="px-item px-chip" data-k="chip" aria-hidden="true">Live in 7 days</div>
    <div class="px-scroll">Scroll</div>
    <div class="px-bar" aria-hidden="true"><i id="bar"></i></div>
  </div>
</div>
<div class="wrap samples-links">
  {sites.map((site) => (
    <a class="cta cta-ghost cta-sm" href={site.url} target="_blank" rel="noopener">Open {site.name} ↗</a>
  ))}
</div>

<script>
  import '../scripts/parallax.js';
</script>
