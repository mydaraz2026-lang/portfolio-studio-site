---
import { contact, journeyUrl } from '../data/site';
---
<div class="wrap hero">
  <span class="eyebrow">Portfolio Studio</span>
  <h1>Elevate your <em>leadership</em> footprint.</h1>
  <p class="sub">Your career story as a fast, executive website.</p>
  <p class="lead">Live in 7 working days. Start with a free CV audit.</p>
  <div class="row"><a class="cta cta-gold" href="#samples">See live samples</a><a class="cta cta-ghost" href={contact.whatsappUrl} target="_blank" rel="noopener">Chat on WhatsApp</a></div>
  <a class="hero-3d" href={journeyUrl}>Or experience it in 3D ↗</a>
  <div class="proof"><span class="live">Live</span><span>Live executive portfolios</span><span><b>7</b> working days</span><span><b>Free</b> CV audit first</span></div>
</div>
